{
  "permissions": {
    "allow": [
      "Bash(pnpm tsc --noEmit *)",
      "Bash(pnpm tsc --noEmit)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm vitest run *)",
      "Bash(pnpm vitest run)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm i *)",
      "Bash(pnpm i)",
      "Bash(pnpm dev *)",
      "Bash(pnpm dev)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git -C * stash)",
      "Bash(git -C * stash *)",
      "Bash(git checkout -b *)",
      "Bash(git -C * checkout -b *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" \"http://localhost:*)",
      "Bash(curl -s -o /dev/null http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\n\" \"http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\n\" http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code} %{content_type}\\n\" http://localhost:*)",
      "Bash(curl -v http://localhost:*)",
      "Bash(curl -s --max-time 5 -o /dev/null -w \"%{http_code}\" \"http://localhost:*)",
      "Bash(pnpm exec biome check --error-on-warnings *)",
      "Bash(pnpm biome check *)",
      "Bash(pnpm exec biome check *)",
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm validate)",
      "Bash(pnpm validate *)",
      "Bash(pnpm snapshot-grid)",
      "Bash(pnpm snapshot-grid *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(pnpm kill-server)",
      "Bash(pnpm kill-server *)",
      "Bash(pnpm playwright test *)",
      "Bash(pnpm playwright test)",
      "Bash(pnpm playwright show-report)",
      "Bash(pnpm playwright test --config temp.playwright.config.ts *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(npx playwright test *)",
      "Bash(pnpm stryker run *)",
      "Bash(pnpm exec stryker run *)",
      "Bash(rtk grep *)",
      "Bash(pnpm lint:theme *)",
      "Bash(pnpm lint:theme)",
      "Bash(rtk proxy grep *)",
      "Bash(ss *)",
      "Bash(rtk ls *)",
      "Bash(git check-ignore *)",
      "Bash(pnpm measure-bonsai-paint *)",
      "Bash(rtk proxy git diff *)",
      "Bash(git -C * diff *)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_find",
      "mcp__code-review-graph__semantic_search_nodes_tool"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.github.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ]
    },
    "excludedCommands": [
      "pnpm dev",
      "pnpm kill-server"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d=''; process.stdin.on('data',c=>d+=c); process.stdin.on('end',()=>{ const p=JSON.parse(d)?.tool_input?.file_path; if(p) process.stdout.write(p); })\" | { read -r f; [ -n \"$f\" ] && pnpm exec biome format --write \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; root=$(git rev-parse --show-toplevel 2>/dev/null); [ -n \"$root\" ] || exit 0; case \"$(code-review-graph status --repo \"$root\" 2>/dev/null)\" in *\"Last updated: never\"*) exit 0;; esac; code-review-graph update --skip-flows --repo \"$root\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules ] || pnpm i || true > /dev/null 2>&1",
            "statusMessage": "Installing dependencies..."
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; s=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/crg-graph-check.sh\"; [ -f \"$s\" ] && bash \"$s\" || echo 'code-review-graph: scripts/crg-graph-check.sh not found, skipping'",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .port ] && PORT=$(cat .port) && PID=$(ss -tlnp \"sport = :$PORT\" 2>/dev/null | grep -oP 'pid=\\K[0-9]+' | head -1) && [ -n \"$PID\" ] && kill -- -$(ps -o pgid= -p $PID 2>/dev/null | tr -d ' ') 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph embed --provider local --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Embedding graph..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright-skill@playwright-skill": false,
    "frontend-design@claude-plugins-official": false
  }
}
